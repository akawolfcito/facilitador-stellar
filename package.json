{
  "name": "stellar-bazaar",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "test": "pnpm -r test",
    "eval:retrieval": "pnpm --filter @stellar-bazaar/retrieval-eval eval",
    "typecheck": "pnpm -r typecheck",
    "eval:retrieval:integration": "pnpm --filter @stellar-bazaar/retrieval-eval eval:integration",
    "calibrate": "pnpm --filter @stellar-bazaar/retrieval-eval calibrate",
    "audit:licenses": "tsx scripts/audit-licenses.mts"
  },
  "devDependencies": {
    "tsx": "4.21.0"
  }
}
